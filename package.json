{
  "name": "ekantah-email-templates",
  "version": "1.0.0",
  "description": "## Booking confirmation",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:migrate:reset": "dotenv -e .env.local -- prisma migrate reset",
    "db:migrate:prod": "dotenv -e .env.local -- prisma migrate deploy",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "test:emails": "dotenv -e .env.local -- tsx scripts/test-emails.ts",
    "test:whatsapp": "NODE_OPTIONS=--conditions=import dotenv -e .env.local -- tsx scripts/test-whatsapp.ts",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20.19.42",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.40.0",
    "html2pdf.js": "^0.10.1",
    "jimp": "^1.6.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "pino": "^10.3.1",
    "prisma": "^6.16.3",
    "puppeteer": "^24.43.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react-datepicker": "^6.2.0",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.22.4"
  }
