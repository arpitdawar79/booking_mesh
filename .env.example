# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ekantah?schema=public"

# Auth
AUTH_SECRET="change-this-to-a-random-secret"
AUTH_REFRESH_SECRET="change-this-to-another-random-secret"

# SMTP (Hostinger defaults)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USERNAME="digital@ekantah.com"
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="digital@ekantah.com"
SMTP_FROM_NAME="The Stream by Ekantah"
SMTP_REPLY_TO="digital@ekantah.com"

# Admin notifications
ADMIN_EMAIL="digital@ekantah.com"

# Optional: WhatsApp group JID for daily admin digest.
# Can be the full JID (e.g. 123456789@g.us) or just the numeric part.
ADMIN_WHATSAPP_GROUP_ID=""

# Review & social links (used in checkout emails)
GOOGLE_REVIEW_URL="https://search.google.com/local/writereview?placeid=PLACEHOLDER"
INSTAGRAM_URL="https://instagram.com/thestreambyekantah"

# Base URL for secure guest feedback and communication preferences links.
APP_BASE_URL="http://localhost:4001"

# Contact import IP attribution: set ONLY if trusted ingress overwrites this header
# and blocks direct origin access. Options: x-real-ip, x-forwarded-for, cf-connecting-ip.
# Empty means available headers are recorded as unverified, never as device identity.
CONTACT_IMPORT_IP_HEADER=""
