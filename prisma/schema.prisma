generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  confirmed
  cancelled
  completed
  archived
}

enum PaymentStatus {
  pending
  partially_paid
  paid_in_full
  refunded
}

enum PaymentMethod {
  upi
  card
  cash
  bank_transfer
}

enum RoomStatus {
  active
  maintenance
}

model Booking {
  id                String        @id @default(cuid())
  bookingId         String        @unique @map("booking_id")
  bookingDate       DateTime      @default(now()) @map("booking_date")
  guestFirstName    String        @map("guest_first_name")
  guestFullName     String        @map("guest_full_name")
  guestEmail        String?       @map("guest_email")
  guestPhone        String?       @map("guest_phone")
  adultCount        Int           @default(1) @map("adult_count")
  childCount        Int           @default(0) @map("child_count")
  checkInDate       DateTime      @map("check_in_date")
  checkOutDate      DateTime      @map("check_out_date")
  checkInTime       String        @default("1:00 PM") @map("check_in_time")
  checkOutTime      String        @default("10:00 AM") @map("check_out_time")
  nightCount        Int           @default(1) @map("night_count")
  roomCount         Int           @default(1) @map("room_count")
  roomType          String        @default("Boutique Room") @map("room_type")
  extraMattressCount Int          @default(0) @map("extra_mattress_count")
  mealPlan          String        @default("As per booking") @map("meal_plan")
  currency          String        @default("INR") @map("currency")
  totalAmount       Decimal       @default(0) @map("total_amount")
  amountPaidOnline  Decimal       @default(0) @map("amount_paid_online")
  balanceAmount     Decimal       @default(0) @map("balance_amount")
  paymentStatus     PaymentStatus @default(partially_paid) @map("payment_status")
  propertyAddress   String        @default("The Stream by Ekantah") @map("property_address")
  propertyPhone     String        @default("+91 93193 47443, +91 99100 06437") @map("property_phone")
  propertyEmail     String        @default("Digital@ekantah.com") @map("property_email")
  caretakerNumber   String        @default("+91 94599 89576") @map("caretaker_number")
  parkingDetails    String        @default("Available near the property. Please contact us before arrival for exact guidance.") @map("parking_details")
  mapLink           String        @default("https://maps.google.com/?q=The%20Stream%20by%20Ekantah%20Tirthan%20Valley") @map("map_link")
  cancellationPolicy String       @default("As per the booking terms shared at the time of reservation.") @map("cancellation_policy")
  specialRequests   String        @default("None shared.") @map("special_requests")
  status            BookingStatus @default(confirmed)
  gstRate           Decimal?      @map("gst_rate")
  cgstAmount        Decimal?      @map("cgst_amount")
  sgstAmount        Decimal?      @map("sgst_amount")
  igstAmount        Decimal?      @map("igst_amount")
  hsnCode           String        @default("996311") @map("hsn_code")
  guestId           String?       @map("guest_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  emailsSent       EmailSent[]
  whatsappMessages WhatsAppMessage[]
  payments         Payment[]
  guest            Guest?    @relation(fields: [guestId], references: [id])

  @@map("bookings")
}

model Guest {
  id          String    @id @default(cuid())
  name        String
  phone       String?   @unique
  email       String?   @unique
  idType      String?   @map("id_type")
  idNumber    String?   @map("id_number")
  address     String?
  preferences String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  bookings    Booking[]

  @@map("guests")
}

model Room {
  id           String     @id @default(cuid())
  roomNumber   String     @unique @map("room_number")
  type         String
  floor        Int?
  maxOccupancy Int        @default(2) @map("max_occupancy")
  status       RoomStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("rooms")
}

model PropertyConfig {
  id         String   @id @default(cuid())
  roomType   String   @map("room_type")
  totalRooms Int      @map("total_rooms")
  basePrice  Decimal? @map("base_price")
  gstRate    Decimal? @map("gst_rate")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([roomType])
  @@map("property_config")
}

model Payment {
  id              String        @id @default(cuid())
  bookingId       String        @map("booking_id")
  amount          Decimal
  method          PaymentMethod
  date            DateTime      @default(now())
  referenceNumber String?       @map("reference_number")
  recordedBy      String?       @map("recorded_by")
  isRefund        Boolean       @default(false) @map("is_refund")
  refundReason    String?       @map("refund_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model EmailSent {
  id        String   @id @default(cuid())
  bookingId String   @map("booking_id")
  type      String
  toEmail   String   @map("to_email")
  ccEmails  String?  @map("cc_emails")
  subject   String
  htmlBody  String   @map("html_body")
  sentAt    DateTime @default(now()) @map("sent_at")
  status    String   @default("sent")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("emails_sent")
}

model WhatsAppMessage {
  id        String   @id @default(cuid())
  bookingId String   @map("booking_id")
  type      String
  toPhone   String   @map("to_phone")
  body      String
  sentAt    DateTime @default(now()) @map("sent_at")
  status    String   @default("sent")
  error     String?
  hasPdf    Boolean  @default(false) @map("has_pdf")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("whatsapp_messages")
}

model AppConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_config")
}

model WhatsAppGroupCache {
  id        String   @id @default(cuid())
  groupId   String   @unique @map("group_id")
  name      String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("whatsapp_group_cache")
}

enum ExpenseCategory {
  utilities
  maintenance
  salaries
  food_beverages
  supplies
  marketing
  transport
  misc
}

enum SaleType {
  restaurant
  activity
  stay
}

enum GuestType {
  outsider
  hotel_guest
}

model Expense {
  id            String          @id @default(cuid())
  date          DateTime        @default(now())
  category      ExpenseCategory
  description   String
  amount        Decimal         @db.Decimal(10, 2)
  paymentMethod PaymentMethod   @default(cash) @map("payment_method")
  recordedBy    String?         @map("recorded_by")
  receiptUrl    String?         @map("receipt_url")
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("expenses")
}

model AdditionalSale {
  id            String        @id @default(cuid())
  date          DateTime      @default(now())
  guestName     String        @map("guest_name")
  saleType      SaleType      @default(restaurant) @map("sale_type")
  guestType     GuestType     @default(outsider) @map("guest_type")
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(cash) @map("payment_method")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("additional_sales")
}

model Employee {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  designation   String   @default("Staff")
  monthlySalary Decimal  @default(0) @map("monthly_salary") @db.Decimal(10, 2)
  joiningDate   DateTime @default(now()) @map("joining_date")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  salarySlips SalarySlip[]

  @@map("employees")
}

model SalarySlip {
  id               String        @id @default(cuid())
  employeeId       String        @map("employee_id")
  month            Int
  year             Int
  daysWorked       Int           @default(30) @map("days_worked")
  totalDays        Int           @default(30) @map("total_days")
  basicSalary      Decimal       @default(0) @map("basic_salary") @db.Decimal(10, 2)
  overtimeDays     Int           @default(0) @map("overtime_days")
  overtimeRate     Decimal       @default(0) @map("overtime_rate") @db.Decimal(10, 2)
  overtimeAmount   Decimal       @default(0) @map("overtime_amount") @db.Decimal(10, 2)
  allowance        Decimal       @default(0) @db.Decimal(10, 2)
  deduction        Decimal       @default(0) @db.Decimal(10, 2)
  deductionReason  String?       @map("deduction_reason")
  netSalary        Decimal       @default(0) @map("net_salary") @db.Decimal(10, 2)
  paymentMethod    PaymentMethod @default(cash) @map("payment_method")
  paymentDate      DateTime?     @map("payment_date")
  notes            String?
  whatsappSentAt   DateTime?     @map("whatsapp_sent_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@map("salary_slips")
}

enum CronStatus {
  running
  success
  failed
}

model CronRun {
  id            String     @id @default(cuid())
  jobName       String     @map("job_name")
  status        CronStatus
  startedAt     DateTime   @map("started_at")
  completedAt   DateTime?  @map("completed_at")
  durationMs    Int?       @map("duration_ms")
  logs          String?
  error         String?
  triggeredBy   String     @default("schedule") @map("triggered_by")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([jobName, startedAt(sort: Desc)])
  @@index([status])
  @@map("cron_runs")
}

enum UserRole {
  admin
  manager
  staff
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         UserRole  @default(staff)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  resetToken   String?   @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
}
